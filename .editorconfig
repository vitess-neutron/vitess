root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,cxx,h,hxx}]
max_line_length = 120
indent_size = 2

[*.tcl]
max_line_length = 120
indent_size = 2

[*.py]
max_line_length = 88
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[*.{htm,html,svg,xml}
indent_size = 2

[*.css]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[Makefile]
indent_style = tab

[*.mak]
charset = latin1
end_of_line = crlf
indent_style = tab

[*.bat]
charset = latin1
end_of_line = crlf
