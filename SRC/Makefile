endif

SUBDIR = $(SYS)
XLIBL = lib
ifeq ($(SYS),Linux)
 CCOMP = gcc
 CC = $(CCOMP) $(CFLAGS)
 GRAOPT2 = -DDO_PNG
 ifeq ($(ARCH),x86_64)
