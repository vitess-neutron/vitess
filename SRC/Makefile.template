# make install just moves binaries to the correct subdirectory
install:
	a=_$(SUBDIR) ; h=$(INSTDIR) ; for l in $(ALL) ; do mv $$l $$h$$l$$a ; done
	-rm -f *.o

# make Copy does the same, but leave binaries in the SRC directory
Copy:
	a=_$(SUBDIR) ; h=$(INSTDIR) ; for l in $(ALL) ; do cp $$l $$h$$l$$a ; done

# make clean removes objects and binaries from the SRC directory
clean :
	-rm -f *.o $(ALL)
