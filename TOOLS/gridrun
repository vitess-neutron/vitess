#!/usr/bin/perl

use File::Copy;
use Cwd qw(abs_path);
use strict;

# Execute a VITESS command pipe on a computer grid.

# This script is meant as a working template to submit a
# grid batch job using n_nodes of the grid, calling n_instances
# of parallel pipe instances on nodes.
# The pipe commands are taken from a file generated by
# "Save Grid Command" within VITESS.
# gridrun works with the Sun Grid Engine (SGE) and ssh remote command execution.

# M. Fromme, HZB, Jan 2013

###############################################################
### configuration
my $testmode = 0;              # 0 for ordinary execution, 1 for tests

my $submit_mode = 'sge';        # may be sge or ssh

my $qsubcom = 'qsub';

my $batchhead_sge =<<'EOS';
#!/bin/bash
#$ -S /bin/bash
#$ -cwd
EOS

my $batchhead_ssh = "\#!/bin/bash\n";

my $wroot = "$ENV{HOME}/.vitess";

### end configuration
###############################################################


# The input file named $filename is a text file with variable definitions of
# V the source module directory
# P the working directory
#  and command option intro strings for the
# G random number generator
# and the command pipe.

# Grid execution has to deal with
# - different file systems, $V and $P may not be present on the grid
# - parallel execution of pipes

# Because execution files may be invisible on grid nodes, we copy them to the
# work directory. We copy all files from $P to pipe sub directories.
# We assume n_instances ( >= 1 ) of work nodes in the grid.
# We want to start parallel pipes.
# Example:
# I'm user JOE, my working dir is /net/home/JOE/vitess on the Linux server dirac at HZB.
# After proper building an instrument with VITESS I found my simulation does take so long
# I'd like to speed that up using the grid engine.
# So first I create the grd file /net/home/JOE/vitess/test.grd
# using the Vitess "Save Grid Command" menu. Contents of this file are
#   V=/net/home/JOE/vitess/MODULES
#   P=/net/home/JOE/vitess/FILES/SAN_DIR
#   G=ran3
#   $V/source_Linux_x86_64 -S1 ...

# To run 4 pipes on the grid engine I call
# gridrun test.grd -p 4
# By default this will be one batch job to run 4 pipes on a single node.
# To use more nodes, I specify a list of compute nodes like
# gridrun test.grd -p 4 --nodes 'all.q@node28 all.q@node29'
# which will run two batch jobs with 2 pipes each.
# The script finds an unused job number <run-nr>, creates ~/.vitess/wdir<run-nr>
# and temporary work directories ~/.vitess/wdir<run-nr>/1 to ~/.vitess/wdir<run-nr>/4 .

# Because /net/home/JOE/vitess/MODULES/ may be invisible for dirac compute nodes (it is invisible),
# all used *_Linux_x86_64 executables are copied to ~/.vitess/wdir<run-nr>, plus this
# script itself, and referenced files from /net/home/JOE/vitess/FILES/SAN_DIR
# plus test.grd are copied to the temporary work directories.

# The information necessary to handle <run-nr> is comprised in the file  ~/.vitess/wdir<run-nr>/job.dat
# lines 0:state  1:time at start  2:submit mode  3:n instances  4:nodes  5:pipe files 6:job name 7:pipe output file name
# gridrun uses it to store the context for later calls to inform about the execution and finally merge
# results.

sub usage {

  print <<'EOS';
usage:
gridrun [option] [filename]

gridrun may be used 
A  to start a VITESS simulation batch job
B  to inform about active jobs
C  to finalize jobs

A) start a job
gridrun [option] filename [batchopt batcharg]
filename             name of a file generated by Vitess "Save Grid Command"
batchopt batcharg    additional arguments for the SGE batch system like -l cpu=8
                     may be repeated
options may be
-p number            number of parallel pipes to start, default 1
-m                   merge neutron trajectory output files
--nodes node-list    list of names of queues to be used
                     enclose lists if more than one queue given, like 'all.q@node28 all.q@node29'
--ssh node-list      use ssh remote execution on these nodes, default is to run SGE jobs
                     enclose lists like above, e.g. 'node28 node29'
--bin modules-dir    directory with VITESS binaries, default is to use those used in the grd file
                     or from the script environment as last resort
--param dir          directory with parameter files, overrides name given in the grd file
--name jobname       you may name the job
--option optstring   special bash command like 'ulimit -s 8192' or 'export LD_LIBRARY_PATH=...'
                     for generated  bash command files, may be repeated

B) inform about jobs
gridrun option
option may be
-I                   show states of all known jobs
-i run-nr            show state of job run-nr

C) finalize jobs
gridrun option
option may be
-F                   finalize all completed, but still not merged,  jobs
-f run-nr            finalize job run-nr
--abort run-nr       aborts job 5 if still waiting for completion
--delete run-nr      deletes all information about job 5, aborting it before, if still active

EOS
  exit 0;
}

my $now = time();

my ($filename, $n_nodes, $n_instances, $vitess_binaries, $vitess_param,
    $grid_mod_dir, $grid_work_dir,
    $op_mode, $jobname, $merge_neutron_trajectories, $neutron_filename,
    $run_nr, $abort_run, $delete_run,
    $pipe_str,
    @Node,  @Pipe, @VBinary, @VFile, @BashOption,
    %Batcharg);

my $gsl_rng_type = 'ran3';      # default PRNG

# parse arguments

while ($_ = shift) {
  if (/^-(.+)/) {
    $_ = $1;
    if (/^-(.+)/) {
      $_ = $1;
      &usage if $_ eq 'help' || $_ eq 'h';
      if ($_ eq 'submit') {
        # special mode, not interactive
        $op_mode = 'submit';
        last;
      }
      if ($_ eq 'nodes' || $_ eq 'ssh') {
        $submit_mode = $_ if /ssh/;
        $_ = shift;
        myexit('please give a list of queue nodes') unless $_;
        @Node = split;
      } elsif ($_ eq 'bin') {
        $vitess_binaries = shift;
      } elsif ($_ eq 'param') {
        $vitess_param = shift;
      } elsif ($_ eq 'abort') {
        $op_mode = 'finalize';
        $abort_run = shift;
      } elsif ($_ eq 'delete') {
        $op_mode = 'finalize';
        $delete_run = shift;
      } elsif ($_ eq 'name') {
        $jobname = shift;
      } elsif ($_ eq 'option') {
        push @BashOption, shift;
      } else {
        &usage;
      }
    } else {
      &usage if $_ eq 'help' || $_ eq 'h';
      if ($_ eq 'm') {
        $merge_neutron_trajectories = 1;
      } elsif ($_ eq 'i') {
        $op_mode = 'info';
        $run_nr = shift;
      } elsif ($_ eq 'I') {
        $op_mode = 'info';
      } elsif ($_ eq 'f') {
        $op_mode = 'finalize';
      } elsif ($_ eq 'F') {
        $op_mode = 'finalize';
        $run_nr = shift;
      }
    }
  } elsif ($filename) {
    $Batcharg{$_} = shift;
  } else {
    $filename = $_;
  }
}

if ($op_mode eq 'submit') {
  &startPipes;
} elsif ($op_mode eq 'info') {
  &infoJobs;
} elsif ($op_mode eq 'finalize') {
  &finalizeJobs;
} elsif ($filename eq '') {
  &infoJobs;
} else {
  &readGrdFile;
  &createWorkdir;
  &startExecution;
}


sub infoJobs {
  return unless (-d $wroot);
  if ($run_nr) {
    $grid_work_dir = "$wroot/wdir$run_nr";
    if (-d $grid_work_dir) {
      infoJob($grid_work_dir);
    } else {
      print "no info for run number $run_nr.\n";
    }
  } else {
    my @Runs;
    opendir D, $wroot;
    while ($_ = readdir D) {
      if (/^wdir([0-9]+)$/) {
        push @Runs, $1 if -d "$wroot/$_";
      }
    }
    closedir D;
    foreach (sort @Runs) {
      infoJob($_, "$wroot/wdir$_");
    }
  }
}

sub infoJob {
  my ($j, $jdir) = @_;

  my ($newstate, $i, $pipe_not_started, @J);
  my $jobfile = "$jdir/job.dat";

  # read job state file
  open F, $jobfile;
  while (<F>) {
    chomp;
    push @J, $_;
  }
  close F;
  $_ = $J[6];
  my $jn = $_ ? " ($_) " : '';
  my $oldstate = $newstate = $_ = $J[0];
  if ($_ eq 'done') {
    print "job $j$jn has been finalized\n";
    return;
  }

  my $pipedone=1;

  # if it's still running, query the state
  if ($_ eq 'running') {
    for ($i=1; -d "$jdir/$i"; $i++) {
      # if a file PIPEDONE exists, this pipe has finished
      next if -f "$jdir/$i/PIPEDONE_";
      $pipedone = 0;
      $pipe_not_started = 1 unless -f "$jdir/$i/PIPETIME_";
    }
    if ($pipedone) {
      # all pipes have finished
      $newstate = 'finished';
    }
  }

  # show state

  if ($newstate eq 'running') {
    print "job $j$jn is running.";
    print " Some pipes did not start yet." if $pipe_not_started;
    print "\n";
  } elsif ($newstate eq 'finished') {
    print "pipes of job $j$jn have finished, you may finalize that job\n";
  }

  # if state had changed, update the state file
  return if $newstate eq $oldstate;
  $J[0] = $newstate;
  open OF, ">$jobfile";
  print OF "$_\n" foreach @J;
  close OF;
}


sub finalizeJobs {
  return unless (-d $wroot);
  if ($run_nr) {
    $grid_work_dir = "$wroot/wdir$run_nr";
    if (-d $grid_work_dir) {
      finalizeJob($run_nr, $grid_work_dir);
    } else {
      print "run number $run_nr does not exist.\n";
    }
  } else {
    my @Runs;
    opendir D, $wroot;
    while ($_ = readdir D) {
      if (/^wdir([0-9]+)$/) {
        push @Runs, $1 if -d "$wroot/$_";
      }
    }
    closedir D;
    foreach (sort @Runs) {
      finalizeJob($_, "$wroot/wdir$_");
    }
  }
}

sub finalizeJob {
  my ($j, $jdir) = @_;

  # read job state file
  my ($i, $newstate, @J);
  my $jobfile = "$jdir/job.dat";

  open F, $jobfile;
  while (<F>) {
    chomp;
    push @J, $_;
  }
  close F;

  my $jn = "job $j";
  $jn .= " ($J[6])" if $J[6];

  my $oldstate = $newstate = $_ = $J[0];
  if ($_ eq '') {
    print "$jn is krank\n";
    return;
  }

  # if it's already finalized, show that information and return
  if ($_ eq 'finalized') {
    print "$jn has been finalized\n";
    return;
  }

  # if it's in state running, query the state
  if ($_ eq 'running') {
    for ($i=1; -d "$jdir/$i"; $i++) {
      unless (-f "$jdir/$i/PIPEDONE_") {
        # show info and return
        print "pipes of $jn have not finished yet.\n";
        return;
      }
    }
  }

  # job has finished, merge results
  return unless mergeResults($jdir, $J[2], $J[5], $J[7]);

  # update the state file
  $J[0] = 'finalized';
  open OF, ">$jobfile";
  print OF "$_\n" foreach @J;
  close OF;

  # delete temp. work directories
  for ($i=1; ; $i++) {
    my $tdir = "$jdir/$i";
    last unless -d $tdir;
    opendir D, $tdir;
    while ($_ = readdir D) {
      next if /^\./;
      unlink "$tdir/$_";
    }
    closedir D;
    rmdir $tdir;
  }

  # show final state
  print "$jn has been finalized.\n";
}


sub startExecution {

  my ($i, $fn, $tdir, @PFiles);

  my $nodes = 0 + @Node;

  # gather existing parameter files
  foreach (@VFile) {
    $fn = "$vitess_param/$_";
    push @PFiles, $_ if -f $fn && -s _;
  }

  # create temp. directories for pipe instances
  for ($i=1; $i<=$n_instances; $i++) {
    $tdir = "$grid_work_dir/$i";
    mkdir $tdir, 0700;
    myexit ("unable to create temp. directory $tdir") unless -d $tdir;
    # copy parameter files to temp. directory
    copy("$vitess_param/$_", "$tdir/$_") foreach @PFiles;
  }

  &createCommandfiles;

  # copy VITESS binaries to work dir
  copy("$vitess_binaries/$_", "$grid_work_dir/$_") foreach @VBinary;

  # copy this script to work dir
  my $cs = "$grid_work_dir/gridrun_";
  copy($0, $cs);

  # match pipe instances to execution nodes / queues
  my ($nexti, $node, $rest, @I, @Match);
  if ($nodes > 1 && $n_instances > 1) {
    # put inst_per_node pipes on each parallel queue
    my $inst_per_node = int($n_instances / $nodes);
    $node = 0;
    if ($inst_per_node <= 1) {
      for ($i=1; $<=$n_instances; $i++) {
        push @Match, "$Node[$node] $i";
        $node++;
      }
    } else {
      $i = 1;
      for ($rest = $n_instances; $rest > 0; $rest -= $inst_per_node) {
        if ($rest > $inst_per_node) {
          $nexti = $i + $inst_per_node;
        } else {
          $nexti = $i + $rest;
        }
        @I = ($i..$nexti-1);
        push @Match, "$Node[$node] @I";
        $i = $nexti;
        $node++;
      }
    }
  } else {
    push @Match, "$Node[0] 1 $n_instances";
  }

  # write state file
  open OF, ">$grid_work_dir/job.dat";
  print OF <<EOS;
running
$now
$submit_mode
$n_instances
@Node
@VFile
$jobname
$neutron_filename
EOS
  close OF;


  # This script has been copied to the work directory, and will be called remotely
  # to fire the VITESS pipes.

  if ($submit_mode eq 'sge') {

    foreach (@Match) {
      my ($node, $first, $last) = split;
      # create a job file for SGE
      my $fn = "$grid_work_dir/job_$first";
      open OF, ">$fn";
      print OF $batchhead_sge;
      print OF "\#\$ $_ $Batcharg{$_}\n" foreach keys %Batcharg;
      print OF "$cs --submit $run_nr $first $last\n";
      close OF;
      # submit that job
      # we do a cd first to have sge log files there
      $_ = `cd $grid_work_dir ; $qsubcom $fn`;
    }

  } else {

    foreach (@Match) {
      my ($node, $first, $last) = split;
      # Use ssh to start a remote shell in the background.
      # We need a bash (bash -c "...") to correctly redirect stdout and stderr (> .. 2>$1),
      # ssh would wait for stdout + stderr completion otherwise.
      $_ = `ssh $node 'bash -c "$cs --submit $run_nr $first $last > $grid_work_dir/$first.log.txt 2>&1" &`;
    }
  }

}


sub createWorkdir {
  mkdir $wroot, 0700 unless -d $wroot;
  myexit("unable to create directory $wroot") unless -d $wroot;

  # find a free run number
  $run_nr = 1;
  opendir D, $wroot;
  while ($_ = readdir D) {
    if (/^wdir([0-9]+)$/) {
      $_ = $1;
      $run_nr = $_ + 1 if $_ >= $run_nr;
    }
  }
  closedir D;
  $grid_work_dir = "$wroot/wdir$run_nr";
  mkdir $grid_work_dir, 0700;
  myexit("unable to create directory $grid_work_dir") unless -d $grid_work_dir;
}


sub readGrdFile {
  # read a VITESS grid file
  # main contents are the pipe command and shell variable definition lines

  myexit("can't read grid job file $filename") unless -s $filename && -r _;

  my ($fmoddir, $fpdir);
  open F, $filename;
  <F>;  # skip bang line
  while (<F>) {
    chomp;
    if (/^\s*\#/) {
      # comment line
      if (/^([VPG])=(.+)$/) {
        # remember special comments
        if ($1 eq 'V') {
          $fmoddir = $2;
        } elsif ($1 eq 'P') {
          $fpdir = $2;
        } else {
          $gsl_rng_type = $_ = lc($2);
          myexit('unknown GSL PRNG specified') unless /^(ran3|taus|gfsr4|mt19937|ranlux)$/;
        }
      }
    } elsif (/\|/) {
      $pipe_str = $_;
      @Pipe = split('\|', $_);
      last;
    }
  }
  close F;
  myexit("found no VITESS pipe in $filename") unless @Pipe;

  # look for binaries and parameter file names accessed in the pipe
  my ($fn, $neutrons, @C, %V, %F);
  my $firstmod = 1;
  foreach (@Pipe) {
    @C = split;
    $_ = shift @C;
    $V{$_} = 1 if /^\$V\/(.+)$/;
    if ($firstmod) {
      myexit('first module should be a source module') unless /^\$V\/source/;
    }

    foreach (@C) {
      next unless /^-([a-zA-Z])(.+)/;
      my $optchar = $1;
      $_ = $2;
      if (/^\$P\/(.+)/) {
        # true file in parameter directory
        $F{$1} = 1;
      } else {
        if ($firstmod) {
          if ($optchar eq 'n') {
            $neutrons = $1;
            next;
          }
        }
        myexit('all parameter files in pipe command should be contained in the parameter directory') if m@/@;
        # skip number (int or float) value parameters
        next if /^[0-9.-]+$/;
        next if /^[0-9.-]+e[0-9-]+$/;
        # what remains could be file names, relative to the parameter directory path
        $F{$_} = 1;
      }
    }
    $firstmod = 0;
  }
  @VFile = keys %F;

  # Extract binary names from pipe, and replace correct image names if necessary
  $_ = `uname`; chomp;
  my $sys = $_;
  $_ = `uname -m`; chomp;
  $sys .= "_$_" if /^x/;
  @VBinary = keys %V;
  my $rep;
  $_ = $VBinary[0];
  unless (/$sys$/) {
    # The grd file has been exported under a different OS
    # We need to replace binary names
    if (/\.exe$/) {
      $rep = '.exe';
    } elsif (/(_Linux.*)$/) {
      $rep = $1;
    } elsif (/(_Darwin.*)$/) {
      $rep = $1;
    }
    @VBinary = ();
  }
  # reconstruct the pipe string, as we have to replace
  # - the number of neutrons of the source module
  # - the PRNG seed of the source module
  # - and may be binaray names
  $_ = shift @Pipe;  # first module command
  my $pn = int($neutrons / $n_instances);
  # reduced number of neutrons, as we have parallel pipes
  s/ -n$neutrons/ -n$pn/;
  # individual PRNG seed, to be filled in later
  s/ --Z[^ ]+ / ZZZZZ /;
  if ($rep) {
    my @OPipe = @Pipe;
    @Pipe = ();
    do {
      @C = split;
      $_ = shift @C;
      s/$rep$/$sys/;
      push @Pipe, join(' ', $_, @C);
      /^\$V\/(.+)$/;
      push @VBinary, $1;
    } while ($_ = shift @OPipe);
  } else {
    unshift @Pipe, $_;
  }

  $pipe_str = join('|', @Pipe);

  if ($merge_neutron_trajectories) {
    # has the last module some output file?
    $_ = $Pipe[$#Pipe];
    if (/ --F([a-zA-Z0-9_.-]+)/) {
      $_ = $1;
      $neutron_filename = $_ if $_ ne 'no_file';
    }
  }

  # check if binaries and parameter directory are accessible here.
  $vitess_binaries = $fmoddir unless $vitess_binaries;
  unless (-d $vitess_binaries) {
    # if not stated explicitly, we try to find them in a MODULES directory
    # in the environement of the gridrun script.
    $_ = abs_path($filename);
    m@^(.+)/[^/]+@;
    $_ = $1;
    $_ = <$_/*/$VBinary[0]>;
    myexit("can't locate binaray $VBinary[0]") unless $_;
    m@^(.+)/[^/]+$@;
    $vitess_binaries = $1;
    myexit("can't access binaries") unless -d $vitess_binaries;
  }

  foreach $fn (@VBinary) {
    $_ = "$vitess_binaries/$fn";
    myexit("can't use VITESS binary $_") unless -x $_;
  }

  $vitess_param = $fpdir unless -d $vitess_param;
  myexit("can't read parameter directory $vitess_param") unless -d $vitess_param;
}

sub createCommandfiles {

  # Create command files for each pipe instance.
  # These are augmented grd files, with specific work directories and PRNG seeds.

  my ($i, $cs, $tdir);

  for ($i=1; $i<=$n_instances; $i++) {
    $tdir = "$grid_work_dir/$i";
    $cs = "$tdir/command_";
    open OF, ">$cs";
    if ( $submit_mode eq 'sge') {
      print OF $batchhead_sge;
      print OF "\#\$ $_ $Batcharg{$_}\n" foreach keys %Batcharg;
    } else {
      print OF $batchhead_ssh;
    }
    print OF "$_\n" foreach @BashOption;
    # replace random seed of source module
    $_ = $pipe_str;
    s/ZZZZZ/--Z$i/;

    print OF <<EOS;
cd $tdir
V=$grid_work_dir
P=$tdir
L=gridlog
export GSL_RNG_TYPE=$gsl_rng_type
touch PIPETIME_
$_
touch PIPEDONE_
EOS

    close OF;
    # set executable
    chmod 0700, $cs;
  }
}


sub startPipes {
  my ($run_nr, $first, $last) = @_;

  # Start pipe instances by spawning the specific command_ scripts.
  # This routine is called when submitted with SGE or ssh, and starts
  # all pipes dedicated to a compute node.

  exit 2 unless $run_nr >= 1 && $first ne '' && $last ne '' && $first >= 1 && $first <= $last;

  $grid_work_dir = "$wroot/wdir$run_nr";
  exit 2 unless -d $grid_work_dir;

  my ($i, $tdir);
  # check if temp. directories exist
  for ($i=$first; $i<=$last; $i++) {
    exit 2 unless -d "$grid_work_dir/$i";
    # do not restart by accident
    exit 2 if -f "$grid_work_dir/$i/PIPETIME_";
  }

  for ($i=$first; $i<=$last; $i++) {
    # call the prepared shell file to invoke the pipe as background job
    $_ = `$grid_work_dir/$i/command_ &`;
  }
}



sub mergeResults {

  my $jdir = shift;
  my $ftime = shift;           # consider only results newer than that
  $_ = shift;                  # vfiles, common file names in pipes
  my @F = split;
  my $ofn = shift;             # pipe output file

  my @Logline;

  my ($i, $lasti, $tdir, $fn, $mfn, $tf, $lines, $tline, @S);

  # list of temp. dirs
  for ($i=1; ; $i++) {
    $tdir = "$jdir/$i";
    last unless -d $tdir;
    push @S, $tdir;
    # extract log files
    open F, "$tdir/gridlog$i" or next;
    push @Logline, "---- Logfile $i --------\n";
    push @Logline, $_ while <F>;
    close F;
  }
  $lasti = $i - 1;

  # write overall log file
  open OF, ">$jdir/gridlog";
  print OF $_ foreach @Logline;
  close OF;

  foreach $mfn (@F) {

    $tf = "$S[0]/$mfn";               # full path of first file accessed in pipe
    next unless -f $tf;               # no plain file
    next if $ftime <= (stat($tf))[9]; # not modified since job start
    $_ = `file $fn`;
    next unless /ASCII /;             # no text file

    # read first file to array @L, and determine the spectrum type
    my ($cols, $skiplines, $skiptext, $err, @I, @L, @N);

    open F, $tf;
    while (<F>) {
      chomp;
      unless ($cols) {
        if (/#/) {
          $skiplines++;
          $skiptext .= "$_\n";
          $cols = -3 if /#x +y +z/;
          next;
        }
        @I = split;
        $cols = 0 + @I;
        if ($cols > 16) {
          # mon2D format 0
          $skiptext .= "$_\n";
          $skiplines = 1;
          next;
        } elsif ($cols != 2 && $cols != 4) {
          # unknown spectrum type
          $err = 1;
          last;
        }
      }
      # normalize numbers
      @I = ();
      foreach (split) {
        push @I, 0+$_;
      }
      push @L, "@I";
      $lines++;
    }
    close F;

    next if $err;

    # merge contents of following files 2..$lasti

    for ($i=2; $i<=$lasti; $i++) {
      $fn = "$jdir/$i/$mfn";
      next unless -s $fn;
      $tline = 0;
      open F, $fn or next;
      for ($i=0; $i<$skiplines; $i++) {
        <F>;
      }
      while (<F>) {
        chomp;
        @N = split;
        last if $tline >= $lines;
        $_ = $L[$tline];
        @I = split;
        if ($cols == 2) {
          $I[1] += $N[1];
        } elsif ($cols == 4) {
          $I[1] += $N[1];
          # $I[2] += $N[2]; # ?? format ??
          $I[3] += $N[3];
        } elsif ($cols == -3) {
          # x y z
          # ignore x,y
          $I[2] += $N[2];
        } elsif ($cols > 16) {
          # first col monitor, then x * count
          for ($i=1; $i<=$cols; $i++) {
            $I[$i] += $N[$i];
          }
        } else {
          $err = 1;
          last;
        }
        $L[$tline] = "@I";
        $tline++;
      }
      close F;
    }

    if ($ofn) {
      # concatenate ouput of last module, if any
      $_ = "$jdir/$lasti/$ofn";
      if (-s $_) {
        # we have some output
        if ($lasti <= 1) {
          # just move that file to the work directory
          rename $_, "$jdir/$ofn";
        } else {
          # concatenate files
          open OF, ">$_";
          my ($i, $r, $buffer);
          for ($i=1; $i<=$lasti; $i++) {
            open F, "$jdir/$i/$ofn";
            while (($r = read F, $buffer, 4096*120) > 0) {
              syswrite OF, $buffer, $r;
            }
            close F;
          }
          close OF;
        }
      }
    }

    # print result to work dir
    open OF, ">$jdir/$mfn";
    print OF $skiptext if $skiptext;
    for ($i=0; $i<$lines; $i++) {
      print OF "$L[$i]\n";
    }
    close OF;

  }
}

sub myexit {
  print "$_[0]!\n";
  exit 2;
}
